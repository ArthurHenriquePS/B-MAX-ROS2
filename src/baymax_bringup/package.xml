<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>baymax_bringup</name>
  <version>0.1.0</version>
  <description>Launch files e configuração para subir o cérebro do Baymax.</description>
  <maintainer email="icbaymax@example.com">icbaymax</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>baymax_brain</exec_depend>
  <exec_depend>baymax_speech</exec_depend>
  <exec_depend>baymax_vision</exec_depend>
  <exec_depend>baymax_motor</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
